{
  "name": "setup-castor",
  "description": "Install castor with a static binary",
  "version": "0.0.0",
  "author": "Joel Wurtz",
  "private": true,
  "homepage": "https://github.com/castor-php/setup-castor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/castor-php/setup-castor.git"
  },
  "bugs": {
    "url": "https://github.com/castor-php/setup-castor/issues"
  },
  "keywords": [
    "actions",
    "castor",
    "node",
    "php",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx oxfmt .",
    "format:check": "npx oxfmt --check .",
    "lint": "npx oxlint --type-aware",
    "typecheck": "npx tsc --noEmit",
    "package": "npx esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --sourcemap --legal-comments=external --banner:js=\"process.setSourceMapsEnabled(true)\"",
    "package:watch": "npm run package -- --watch",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  }
}
